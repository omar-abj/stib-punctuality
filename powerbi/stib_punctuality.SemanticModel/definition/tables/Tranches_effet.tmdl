/// Ranges of stop-specific effect (in points) for the histogram of the Stops page. Disconnected table: lower bound included, upper bound excluded.
table Tranches_effet
	lineageTag: 4b29e99d-abcd-47b2-b93a-2c0538063bb6

	column Order
		lineageTag: 3c2f96ce-a594-459d-b0da-9ff79814f431
		isNameInferred
		sourceColumn: [Order]

	column Range
		lineageTag: 3129ffee-5eee-49c4-a0a5-03a48bd44c4c
		isNameInferred
		sourceColumn: [Range]

	column 'Lower bound'
		lineageTag: 6eedc8b9-eb66-4d22-9998-a583162d65c3
		isNameInferred
		sourceColumn: [Lower bound]

	column 'Upper bound'
		lineageTag: d6f33f4c-3742-4004-a9b0-4a43a4823f02
		isNameInferred
		sourceColumn: [Upper bound]

	partition Tranches_effet = calculated
		mode: import
		source =
				DATATABLE (
				    "Order", INTEGER,
				    "Range", STRING,
				    "Lower bound", DOUBLE,
				    "Upper bound", DOUBLE,
				    {
				        { 1, "-20 or less", -1000, -20 },
				        { 2, "-20 to -15",    -20,   -15 },
				        { 3, "-15 to -10",    -15,   -10 },
				        { 4, "-10 to -5",     -10,    -5 },
				        { 5, "-5 to 0",        -5,     0 },
				        { 6, "0 to +5",         0,     5 },
				        { 7, "+5 to +10",       5,    10 },
				        { 8, "+10 to +15",     10,    15 },
				        { 9, "+15 to +20",     15,    20 },
				        { 10, "+20 or more",  20,  1000 }
				    }
				)

