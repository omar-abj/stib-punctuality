/// Indicator choice for the Explore page. "Favourable direction" is 1 when a high value is good (on-time rate) and -1 when it is bad. Disconnected table.
table Choix_indicateur
	lineageTag: 79ea87ad-c3fc-413c-b29d-a6a448cef654

	column Order
		lineageTag: d166f23f-bb74-41c9-ae87-cf991665138b
		isNameInferred
		sourceColumn: [Order]

	column Indicator
		lineageTag: 2097525d-9337-4d29-8c1b-761d46b45b1c
		isNameInferred
		sourceColumn: [Indicator]

	column 'Favourable direction'
		lineageTag: 5ba4b7a1-bfbc-4530-99ad-a3ad4072feb2
		isNameInferred
		sourceColumn: [Favourable direction]

	partition Choix_indicateur = calculated
		mode: import
		source =
				DATATABLE (
				    "Order", INTEGER,
				    "Indicator", STRING,
				    "Favourable direction", INTEGER,
				    {
				        { 1, "On-time rate",   1 },
				        { 2, "Early",    -1 },
				        { 3, "Late",    -1 },
				        { 4, "Not found", -1 }
				    }
				)

