/// The 4 cascade categories, in display order. Disconnected table: no relationship, values come from the Category share measure.
table Cascade_postes
	lineageTag: 2c6df412-f403-4629-9650-43a245e9b2b5

	column Order
		lineageTag: 9c889bf2-3004-492e-9246-d7f915f4afc4
		isNameInferred
		sourceColumn: [Order]

	column Category
		lineageTag: 641aa8b3-919e-49d3-ad70-94ddaf399dc4
		isNameInferred
		sourceColumn: [Category]
		sortByColumn: Order

	partition Cascade_postes = calculated
		mode: import
		source =
				DATATABLE (
				    "Order", INTEGER,
				    "Category", STRING,
				    {
				        { 1, "On time" },
				        { 2, "Early" },
				        { 3, "Late" },
				        { 4, "Not found" }
				    }
				)

